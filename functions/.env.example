# functions/.env is deployed together with the Cloud Functions and its
# values are populated into process.env at runtime. Do NOT use
# `firebase functions:config:set` — the functions.config() API and the
# Cloud Runtime Config service it depends on are deprecated and shut down
# in March 2026.

KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
EMAIL_USER=
EMAIL_PASS=
