rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }

    // exists() check prevents null.data error when user doc doesn't exist yet
    function userRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null)
        : null;
    }
    function isAdmin() { return isAuth() && userRole() == 'admin'; }
    function isSeventy() { return isAuth() && userRole() == 'seventy'; }
    function isPresident() { return isAuth() && userRole() == 'president'; }
    function isExecSecretary() { return isAuth() && userRole() == 'exec_secretary'; }
    function myAssignedSeventy() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('assignedSeventyUid', null)
        : null;
    }

    function invitePath() {
      return /databases/$(database)/documents/invites/$(request.auth.token.email);
    }
    function invite() { return get(invitePath()).data; }
    // 초대장이 있고, 그 초대장이 바로 이 역할로 초대한 것이어야 한다. 있기만 하면 통과시키던
    // 예전 규칙에서는 집행서기로 초대된 사람이 자기 문서를 seventy로 만들 수 있었다.
    function invitedAs(role) { return exists(invitePath()) && invite().get('role', null) == role; }
    // resolveUser(authService.ts)가 초대장에서 지역을 옮겨 적는 규칙과 같아야 한다.
    function inviteRegionIds() {
      return invite().get('assignedRegionIds', []).size() > 0
        ? invite().assignedRegionIds
        : (invite().get('assignedRegionId', null) != null ? [invite().assignedRegionId] : []);
    }

    match /users/{uid} {
      // Admin: all users. Seventy: all users (needed to resolve president names in task progress).
      // President/others: own document only.
      allow read: if isAuth() && (request.auth.uid == uid || isAdmin() || isSeventy() || isExecSecretary());
      // Cloud Functions는 role·assignedSeventyUid·regionIds·unitId를 권한 근거로 믿는다 —
      // 그러니 사용자가 자기 문서를 만들 때 이 값들을 마음대로 고를 수 없어야 한다.
      allow create: if isAuth() && request.auth.uid == uid
        && (
          // 초대 없는 가입자: 온보딩이 이름·소속만 받아 승인 대기로 저장한다.
          (request.resource.data.role == 'pending'
              && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'unitId', 'regionId', 'createdAt']))
          // 초대받은 회장: 소속은 본인이 온보딩에서 고른다.
          || (request.resource.data.role == 'president'
              && invitedAs('president')
              && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'unitId', 'regionId', 'createdAt']))
          // Admin: email must match settings/admin
          || (request.resource.data.role == 'admin'
              && exists(/databases/$(database)/documents/settings/admin)
              && request.auth.token.email == get(/databases/$(database)/documents/settings/admin).data.get('email', null))
          // Seventy: 담당 지역은 초대장에 적힌 그대로
          || (request.resource.data.role == 'seventy'
              && invitedAs('seventy')
              && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'regionIds', 'regionId', 'createdAt'])
              && request.resource.data.get('regionIds', []) == inviteRegionIds()
              && request.resource.data.get('regionId', null)
                   == (inviteRegionIds().size() > 0 ? inviteRegionIds()[0] : null))
          // ExecSecretary: 담당 seventy는 초대장에 적힌 그대로
          || (request.resource.data.role == 'exec_secretary'
              && invitedAs('exec_secretary')
              && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'assignedSeventyUid', 'createdAt'])
              && request.resource.data.get('assignedSeventyUid', null) == invite().get('assignedSeventyUid', null))
        );
      // Admin can update any user's doc, but cannot change their own role (self-demotion prevention).
      // 본인은 표시 이름과 캘린더 구독 표시만 고친다 — 나머지는 권한 근거라 관리자 몫이다.
      allow update: if (isAdmin() && (request.auth.uid != uid || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])))
        || (isAuth() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'calendarConnected']));
    }

    match /invites/{email} {
      allow read: if isAdmin() || (isAuth() && request.auth.token.email == email);
      allow write: if isAdmin();
    }

    match /regions/{regionId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /units/{unitId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /availability/{seventyUid}/slots/{slotId} {
      allow read: if isAdmin() || isPresident() || (isSeventy() && request.auth.uid == seventyUid);
      allow write: if isAdmin() || (isSeventy() && request.auth.uid == seventyUid);
    }

    match /schedules/{scheduleId} {
      // Admin: all. Seventy: only schedules they are assigned to (seventyUid).
      // ExecSecretary: schedules belonging to their assigned seventy.
      // President: only their own confirmed schedules.
      allow read: if isAuth() && (
        isAdmin()
        || (isSeventy() && resource.data.seventyUid == request.auth.uid)
        || (isExecSecretary() && resource.data.seventyUid == myAssignedSeventy())
        || resource.data.presidentUid == request.auth.uid
      );
      allow create, update, delete: if isAdmin() || isExecSecretary();
    }

    // 일정의 칠십인 전용 메모. 일정 문서(schedules)는 연결된 회장도 읽으므로 메모만 따로 둔다 —
    // 규칙은 문서 단위라 한 필드만 가릴 수 없다. 쓰기는 Cloud Functions(adminCreateSchedule,
    // adminEditSchedule)만 한다.
    match /scheduleSeventyNotes/{scheduleId} {
      allow read: if isAdmin()
        || (isSeventy() && resource.data.seventyUid == request.auth.uid)
        || (isExecSecretary() && resource.data.seventyUid == myAssignedSeventy());
      allow write: if false;
    }

    // 행사의 칠십인 전용 메모. 행사 문서는 회장도 읽으므로 메모만 따로 둔다. 읽는 사람은 칠십인
    // 전용 행사를 볼 수 있는 사람과 같고, 쓰는 사람은 그 행사를 고칠 수 있는 사람과 같다
    // (관리자, 또는 그 행사를 만든 칠십인·집행서기). 행사와 메모를 한 배치로 쓰므로 만들 때는
    // getAfter로 "이 배치가 끝난 뒤의 행사"를 보고, 지울 때는 행사가 같은 배치에서 함께 지워질 수
    // 있으니 get으로 "지우기 전의 행사"를 본다.
    match /generalScheduleSeventyNotes/{scheduleId} {
      allow read: if isAdmin() || isSeventy() || isExecSecretary();
      allow create, update: if isAdmin()
        || ((isSeventy() || isExecSecretary())
            && getAfter(/databases/$(database)/documents/generalSchedules/$(scheduleId)).data.createdBy == request.auth.uid);
      allow delete: if isAdmin()
        || ((isSeventy() || isExecSecretary())
            && get(/databases/$(database)/documents/generalSchedules/$(scheduleId)).data.createdBy == request.auth.uid);
    }

    match /generalSchedules/{scheduleId} {
      // 칠십인 전용 행사(seventyOnly)는 관리자·칠십인·집행서기만 읽는다. 그 밖의 로그인 사용자
      // (회장 등)는 seventyOnly가 false인 행사만 읽는다 — 그래서 회장 계정의 목록 조회는
      // where('seventyOnly', '==', false)를 달아야 통과한다(generalScheduleService.ts).
      // 칠십인 전용 행사는 isPublic이 false로 저장되므로 로그인 없는 읽기에도 걸리지 않는다.
      // resource.data.get('seventyOnly', false)로 쓰지 마라 — 기본값이 있으면 조건 없는 목록 조회가
      // 통과해 칠십인 전용 행사가 회장에게 그대로 내려간다(rules-tests가 이 경우를 잡는다).
      // 필드가 없는 옛 문서는 backfill-seventy-only.ts와 generalScheduleCalendarSync가 채운다.
      allow read: if (isAuth() && (
          isAdmin() || isSeventy() || isExecSecretary()
          || resource.data.seventyOnly == false
        ))
        || resource.data.isPublic == true;
      // Admin, seventy, and exec_secretary create org-wide events. 수정·삭제는 관리자와
      // 만든 사람만 — 화면(GeneralScheduleDetailSheet의 canManage)과 같은 기준이다.
      allow create: if (isAdmin() || isSeventy() || isExecSecretary())
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        || ((isSeventy() || isExecSecretary())
            && resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isAdmin()
        || ((isSeventy() || isExecSecretary()) && resource.data.createdBy == request.auth.uid);
    }

    match /visitPlans/{planId} {
      // 방문 계획 도구는 admin 및 exec_secretary 전용
      allow read, write: if isAdmin() || isExecSecretary();
    }

    match /projects/{projectId} {
      // 프로젝트 메모는 admin 및 exec_secretary 전용
      allow read, write: if isAdmin() || isExecSecretary();
    }

    match /tasks/{taskId} {
      // Admin: all. Seventy: only tasks in their region (seventyUid matches).
      // ExecSecretary: tasks belonging to their assigned seventy.
      // President: only tasks assigned to them.
      allow read: if isAuth() && (
        isAdmin()
        || (isSeventy() && resource.data.seventyUid == request.auth.uid)
        || (isExecSecretary() && resource.data.seventyUid == myAssignedSeventy())
        || resource.data.assignedTo == request.auth.uid
      );
      allow create, delete: if isAdmin() || isExecSecretary();
      // Admin: unrestricted. ExecSecretary: unrestricted. Seventy: only their region's tasks, status-only.
      // President: own tasks, limited fields only.
      allow update: if isAdmin()
        || isExecSecretary()
        || (isSeventy() && resource.data.seventyUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status']))
        || (isAuth() && resource.data.assignedTo == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'respondedSlots', 'respondedAt',
                            'wardAssignments']));
    }

    match /notifications/{uid}/items/{notifId} {
      allow read, write: if isAuth() && request.auth.uid == uid;
    }

    // 공개 일정표 관련 세 문서는 「설정 › 공유」가 쓰고, 그 화면은 관리자와
    // 집행서기가 함께 본다(스펙 §4.3). 나머지 settings 문서는 시스템 배선이라
    // 관리자 전용으로 남는다 — 규칙을 settings/{doc} 전체로 열지 않는다.
    match /settings/{doc} {
      // 공개 링크 문서에는 토큰이 들어 있다 — 토큰 하나면 로그인 없이 일정표 전체(메모 포함)를
      // 읽으니, 그 문서들은 링크를 관리하는 사람만 읽는다. 나머지(calendar·admin)는 가입 흐름과
      // 캘린더 구독이 로그인한 누구에게나 읽혀야 한다.
      allow read: if doc in ['public', 'publicUnits', 'publicTokens']
        ? (isAdmin() || isExecSecretary())
        : isAuth();
      allow write: if isAdmin()
        || (isExecSecretary()
            && doc in ['public', 'publicUnits', 'publicTokens']);
    }

    match /userSettings/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
    }

    match /leaders/{leaderId} {
      // All authenticated users can read (auto-fill needs seventy role)
      allow read: if isAuth();
      // Only admin can write (import script runs with admin SDK, bypasses rules)
      allow write: if isAdmin();
    }

    match /kakaoTokens/{uid} {
      // 리프레시 토큰은 해당 카카오 계정의 캘린더를 2개월간 조작할 수 있는
      // 자격 증명이다. 본인조차 클라이언트에서 읽을 이유가 없다.
      // Cloud Functions는 admin SDK를 쓰므로 이 규칙을 우회한다.
      allow read, write: if false;
    }
  }
}
